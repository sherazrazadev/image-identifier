---
import BaseLayout from "./BaseLayout.astro";

const {
  title,
  description,
  date = null,
  updated = null,
  readMinutes = null,
  author = null,
  ogType = "article",
  noindex = false,
} = Astro.props;
---

<BaseLayout title={title} description={description} ogType={ogType} noindex={noindex}>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:px-6" itemscope itemtype="https://schema.org/Article">
    <p class="m-0 text-sm text-muted">
      <a href="/" class="text-muted no-underline hover:text-fg">Home</a>
      <span class="mx-2 text-border">/</span>
      <slot name="crumb" />
    </p>
    <h1 class="font-display text-3xl font-bold text-fg m-0 mt-4 text-balance" itemprop="headline">
      {title}
    </h1>
    {
      (date || readMinutes || author) && (
        <p class="mt-2 mb-0 text-sm text-muted">
          {author ? <span itemprop="author">{author}</span> : null}
          {author && date ? <span class="mx-2">·</span> : null}
          {date ? (
            <time datetime={date} itemprop="datePublished">
              {date}
            </time>
          ) : null}
          {updated && updated !== date ? (
            <>
              <span class="mx-2">·</span>
              Updated{" "}
              <time datetime={updated} itemprop="dateModified">
                {updated}
              </time>
            </>
          ) : date ? (
            <meta itemprop="dateModified" content={updated || date} />
          ) : null}
          {(date || author) && readMinutes ? <span class="mx-2">·</span> : null}
          {readMinutes ? <span>{readMinutes} min read</span> : null}
        </p>
      )
    }
    <div
      class="article-body mt-8 text-muted leading-relaxed space-y-4 [&_h2]:font-display [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-fg [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:m-0 [&_ul]:pl-5 [&_ul]:space-y-2 [&_ol]:pl-5 [&_ol]:space-y-2 [&_table]:w-full [&_table]:text-sm [&_th]:text-left [&_th]:font-semibold [&_th]:text-fg [&_td]:py-1.5 [&_th]:py-1.5 [&_a]:text-accent"
      itemprop="articleBody"
    >
      <slot />
    </div>
    <p class="mt-12 mb-0 rounded-[var(--radius)] border border-border bg-bg-elevated/80 px-4 py-4 text-sm text-muted">
      Ready to check a photo?
      <a href="/" class="font-semibold text-accent">Use the free tool</a>
      — results are estimates, not legal proof. See the
      <a href="/faq/" class="text-accent">FAQ</a>.
    </p>
  </article>
</BaseLayout>
