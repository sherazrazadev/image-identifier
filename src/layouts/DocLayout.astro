---
import BaseLayout from "./BaseLayout.astro";

const { title, description, updated, noindex = true } = Astro.props;
---

<BaseLayout title={title} description={description} ogType="article" noindex={noindex}>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:px-6">
    <p class="m-0 text-sm text-muted">
      <a href="/" class="text-accent-link no-underline hover:underline">Tool</a>
      <span class="mx-2 text-border">/</span>
      <a href="/guides/" class="text-accent-link no-underline hover:underline">Guides</a>
    </p>
    <h1 class="font-display text-3xl font-bold text-fg m-0 mt-4 text-balance">{title}</h1>
    {
      updated && (
        <p class="mt-2 mb-0 text-xs text-muted">Updated {updated}</p>
      )
    }
    <div class="doc-prose mt-8 text-muted [&_h2]:font-display [&_h2]:text-fg [&_h2]:text-xl [&_h2]:font-bold [&_h2]:mt-10 [&_h2]:mb-3 [&_h3]:font-display [&_h3]:text-fg [&_h3]:text-base [&_h3]:font-semibold [&_h3]:mt-6 [&_h3]:mb-2 [&_p]:leading-relaxed [&_p]:mb-4 [&_ul]:mb-4 [&_ul]:pl-5 [&_li]:mb-1.5 [&_a]:text-accent-link">
      <slot />
    </div>
    <p class="mt-10 mb-0 text-sm">
      <a href="/" class="inline-flex min-h-11 items-center rounded-xl border border-border bg-bg-elevated px-4 py-2 font-semibold text-fg no-underline hover:border-accent/50">
        Open Image Identifier
      </a>
    </p>
  </article>
</BaseLayout>
