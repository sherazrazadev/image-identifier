---
import ArticleLayout from "../layouts/ArticleLayout.astro";

const faqs = [
  {
    q: "Is Image Identifier free?",
    a: "Yes. You can check JPEG or PNG images in your browser at no charge.",
  },
  {
    q: "Do you upload my image to your servers?",
    a: "No. The image you select is processed in your browser for the check. The site may still load normal web assets (scripts, styles, and runtime files) over the network. See Privacy for details.",
  },
  {
    q: "Is the result legal proof or a certificate?",
    a: "No. Results are informal estimates only. They are not legal advice, forensic reports, court evidence, journalistic verification, or certificates of authenticity. Do not rely on them as the sole basis for legal, school, employment, insurance, or high-stakes decisions.",
  },
  {
    q: "Can the tool be wrong?",
    a: "Yes. AI image checks can mislabel real photos as AI-generated and miss some AI images. Edited, compressed, cropped, or re-saved files are especially hard. Treat every answer as a helpful hint, not a final judgment.",
  },
  {
    q: "What file types are supported?",
    a: "JPEG and PNG, up to 15 MB per file.",
  },
  {
    q: "Why does the first check take longer?",
    a: "Your browser may need to download runtime files the first time. Later checks on the same device are often faster when those files stay cached.",
  },
  {
    q: "Who should use this tool?",
    a: "Anyone who wants a quick, private sense of whether a photo looks AI-generated or real — for everyday curiosity, social media caution, or teaching digital literacy. It is not a substitute for professional investigation.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<ArticleLayout
  title="FAQ"
  description="Frequently asked questions about Image Identifier — free AI vs real checks, privacy, and why results are not legal proof."
>
  <span slot="crumb" class="text-fg">FAQ</span>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <p>
    Short answers about how the free check works, what we store, and what the results mean.
  </p>

  <div class="space-y-4 !mt-8">
    {
      faqs.map((item) => (
        <section class="m-0 rounded-[var(--radius)] border border-border bg-bg-elevated/80 px-4 py-4 sm:px-5">
          <h2 class="!mt-0 !mb-2 text-base !font-semibold">{item.q}</h2>
          <p class="m-0 text-sm sm:text-base">{item.a}</p>
        </section>
      ))
    }
  </div>

  <p class="!mt-10">
    More detail:
    <a href="/privacy/">Privacy</a>,
    <a href="/terms/">Terms</a>, and
    <a href="/blog/">Blog</a>.
  </p>
</ArticleLayout>
