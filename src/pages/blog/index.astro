---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPostDate, getPublishedPosts } from "../../lib/content/blog.js";

const posts = await getPublishedPosts();
const [featured, ...rest] = posts;
---

<BaseLayout
  title="Blog"
  description="Guides on AI-generated vs real photos, free browser AI image checkers, and why online detectors are not legal proof."
>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="m-0 text-sm text-muted">
      <a href="/" class="text-muted no-underline hover:text-fg">Home</a>
      <span class="mx-2 text-border">/</span>
      <span class="text-fg">Blog</span>
    </p>
    <h1 class="font-display text-3xl font-bold text-fg m-0 mt-4">Blog</h1>
    <p class="mt-3 text-muted leading-relaxed m-0 max-w-2xl">
      Practical articles for people searching how to tell AI images from real photos — written for
      everyday readers, not specialists.
    </p>

    {
      featured && (
        <a
          href={`/blog/${featured.id}/`}
          class="mt-10 block no-underline rounded-[var(--radius)] border-2 border-accent/35 bg-accent/8 px-5 py-6 sm:px-7 sm:py-8 group"
        >
          <p class="m-0 text-xs font-semibold uppercase tracking-[0.12em] text-accent-link">Latest</p>
          <h2 class="font-display text-2xl sm:text-[1.65rem] font-bold text-fg m-0 mt-2 group-hover:text-accent-link text-balance">
            {featured.data.title}
          </h2>
          <p class="m-0 mt-3 text-muted leading-relaxed">{featured.data.description}</p>
          <p class="m-0 mt-4 text-xs text-muted">
            <time datetime={formatPostDate(featured.data.date)}>
              {formatPostDate(featured.data.date)}
            </time>
            <span class="mx-2">·</span>
            {featured.data.readMinutes} min read
            <span class="mx-2">·</span>
            {featured.data.author}
          </p>
        </a>
      )
    }

    <ul class="mt-6 list-none p-0 space-y-3">
      {
        rest.map((post) => (
          <li class="m-0 rounded-[var(--radius)] border border-border bg-bg-elevated/90 px-5 py-5">
            <a href={`/blog/${post.id}/`} class="no-underline block group">
              <p class="m-0 text-xs text-muted">
                <time datetime={formatPostDate(post.data.date)}>{formatPostDate(post.data.date)}</time>
                <span class="mx-2">·</span>
                {post.data.readMinutes} min read
              </p>
              <h2 class="font-display text-xl font-bold text-fg m-0 mt-2 group-hover:text-accent-link text-balance">
                {post.data.title}
              </h2>
              <p class="m-0 mt-2 text-sm text-muted leading-relaxed">{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 mb-0 text-sm text-muted">
      Prefer to check a file now?
      <a href="/" class="text-accent-link font-semibold">Open the free tool</a>.
    </p>
  </section>
</BaseLayout>
