---
import BaseLayout from "../layouts/BaseLayout.astro";
import UploadTool from "../components/app/UploadTool.jsx";
---

<BaseLayout
  title="Image Identifier"
  description="Check authenticity signals in an image file — credentials, file details, and an optional local statistical check. Evidence in your browser, not a guarantee."
>
  <section class="mx-auto max-w-5xl px-4 pb-16 pt-10 sm:px-6 sm:pt-14">
    <div class="mx-auto max-w-[var(--max-tool)] text-center">
      <p class="font-display-hero text-3xl text-fg sm:text-4xl m-0">
        Image Identifier
      </p>
      <h1 class="font-display-hero mt-4 text-2xl text-fg sm:text-[1.75rem] m-0 text-balance">
        Check an Image's Origin and Authenticity Signals
      </h1>
      <p class="mt-3 text-base text-muted m-0 text-pretty mx-auto max-w-xl">
        Drop in a photo to review the evidence available in the file — not a guarantee of authenticity.
      </p>
    </div>

    <div class="mt-8 sm:mt-10">
      <UploadTool client:load />
    </div>
  </section>
</BaseLayout>
