---
import { Gauge, Info, Lock, Scale } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import UploadTool from "../components/app/UploadTool.jsx";
import AdSlot from "../components/AdSlot.astro";
import { getPublishedPosts } from "../lib/content/blog.js";

const featured = (await getPublishedPosts()).slice(0, 3);

// Copy is unchanged in meaning: no method details, no new claims.
const helps = [
  {
    Icon: Gauge,
    title: "Simple result",
    body: "See Likely AI-generated, Likely real, or Unclear in a large, easy-to-read panel.",
  },
  {
    Icon: Lock,
    title: "Stays in your browser",
    body: "Your selected image is not uploaded to our servers for analysis.",
    link: { href: "/privacy/", label: "Privacy policy" },
  },
  {
    Icon: Scale,
    title: "Honest limits",
    body: "Estimates can be wrong. Not for court, school discipline, or other high-stakes decisions.",
    link: { href: "/faq/", label: "Read the FAQ" },
  },
];
---

<BaseLayout
  title="Image Identifier"
  description="Free AI image checker: is this photo AI-generated or real? Runs in your browser. Not legal proof."
>
  <section class="mx-auto max-w-5xl px-4 pb-12 pt-8 sm:px-6 sm:pb-16 sm:pt-12">
    <div class="mx-auto max-w-3xl text-center">
      <p class="m-0 text-xs font-semibold uppercase tracking-[0.16em] text-accent-link">
        Image Identifier
      </p>
      <h1 class="font-display-hero mt-3 m-0 text-3xl text-fg sm:text-5xl text-balance">
        Is this image <span class="whitespace-nowrap">AI-generated</span> or real?
      </h1>
      <p class="mt-4 text-base text-muted m-0 text-pretty mx-auto max-w-xl sm:text-lg">
        Free check in your browser. Drop a photo and get a clear answer.
      </p>
    </div>

    <div class="mt-8 sm:mt-10">
      <UploadTool client:load />
    </div>
  </section>

  <section class="border-t border-border" aria-labelledby="how-heading">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
      <p class="m-0 text-xs font-semibold uppercase tracking-[0.16em] text-accent-link">Why use it</p>
      <h2 id="how-heading" class="font-display text-2xl font-bold text-fg m-0 mt-2 sm:text-3xl">
        How it helps
      </h2>
      <p class="mt-2 mb-0 max-w-2xl text-base text-muted text-pretty">
        Built for everyday users who want a fast yes/no-style signal — not a technical report.
      </p>
      <ul class="mt-8 grid list-none gap-4 p-0 sm:grid-cols-3">
        {
          helps.map(({ Icon, title, body, link }) => (
            <li class="m-0 flex flex-col rounded-[var(--radius)] border border-border bg-bg-elevated p-6 shadow-sm">
              <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent/15 text-accent-link">
                <Icon className="h-5 w-5" strokeWidth={1.75} aria-hidden="true" />
              </span>
              <p class="font-display m-0 mt-4 text-lg font-bold text-fg">{title}</p>
              <p class="m-0 mt-2 text-sm leading-relaxed text-muted">{body}</p>
              {link ? (
                <a href={link.href} class="mt-auto pt-4 text-sm font-semibold text-accent-link">
                  {link.label}
                </a>
              ) : null}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <AdSlot name="home-mid" class="px-4 pb-12 sm:px-6" />

  <section class="border-t border-border" aria-labelledby="blog-heading">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="m-0 text-xs font-semibold uppercase tracking-[0.16em] text-accent-link">Guides</p>
          <h2 id="blog-heading" class="font-display text-2xl font-bold text-fg m-0 mt-2 sm:text-3xl">
            From the blog
          </h2>
          <p class="mt-2 mb-0 max-w-xl text-base text-muted text-pretty">
            Plain-language guides on spotting AI images and what checkers can and can’t tell you.
          </p>
        </div>
        <a href="/blog/" class="shrink-0 text-sm font-semibold text-accent-link">All posts →</a>
      </div>
      <ul class="mt-8 grid list-none gap-4 p-0 sm:grid-cols-3">
        {
          featured.map((post) => (
            <li class="m-0">
              <a
                href={`/blog/${post.id}/`}
                class="group flex h-full flex-col rounded-[var(--radius)] border border-border bg-bg-elevated p-6 no-underline shadow-sm transition hover:border-accent"
              >
                <p class="m-0 text-xs font-semibold uppercase tracking-[0.12em] text-muted">
                  {post.data.readMinutes} min read
                </p>
                <p class="font-display m-0 mt-3 text-lg font-bold leading-snug text-fg text-balance group-hover:text-accent-link">
                  {post.data.title}
                </p>
                <p class="m-0 mt-2 line-clamp-3 text-sm leading-relaxed text-muted">
                  {post.data.description}
                </p>
                <span class="mt-auto pt-4 text-sm font-semibold text-accent-link">Read guide →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
      <div
        class="flex gap-4 rounded-[var(--radius)] border border-border border-l-[6px] border-l-muted bg-bg-elevated p-6 text-sm leading-relaxed text-muted shadow-sm"
      >
        <Info className="mt-0.5 h-5 w-5 shrink-0 text-muted" aria-hidden="true" />
        <div>
          <p class="font-display m-0 text-base font-bold text-fg">Important</p>
          <p class="m-0 mt-2">
            Image Identifier provides free, informal estimates only. It is not legal proof, a
            certificate of authenticity, or professional advice. Learn more in
            <a href="/terms/" class="text-accent-link">Terms</a>,
            <a href="/faq/" class="text-accent-link">FAQ</a>, and
            <a href="/blog/why-ai-image-checkers-are-not-legal-proof/" class="text-accent-link"
              >why checkers are not legal proof</a
            >.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
