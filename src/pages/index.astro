---
import BaseLayout from "../layouts/BaseLayout.astro";
import UploadTool from "../components/app/UploadTool.jsx";
import { getPublishedPosts } from "../lib/content/blog.js";

const featured = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout
  title="Image Identifier"
  description="Free AI image checker: is this photo AI-generated or real? Runs in your browser. Not legal proof."
>
  <section class="mx-auto max-w-5xl px-4 pb-10 pt-10 sm:px-6 sm:pt-14">
    <div class="mx-auto max-w-[var(--max-tool)] text-center">
      <p class="font-display-hero text-3xl text-fg sm:text-4xl m-0">Image Identifier</p>
      <h1 class="font-display-hero mt-4 text-2xl text-fg sm:text-[1.75rem] m-0 text-balance">
        Is this image AI-generated or real?
      </h1>
      <p class="mt-3 text-base text-muted m-0 text-pretty mx-auto max-w-xl">
        Free check in your browser. Drop a photo and get a clear answer.
      </p>
    </div>

    <div class="mt-8 sm:mt-10">
      <UploadTool client:load />
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-12 sm:px-6" aria-labelledby="how-heading">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="how-heading" class="font-display text-2xl font-bold text-fg m-0">How it helps</h2>
      <p class="mt-2 text-muted m-0 text-pretty">
        Built for everyday users who want a fast yes/no-style signal — not a technical report.
      </p>
    </div>
    <ul class="mt-8 grid list-none p-0 gap-4 sm:grid-cols-3 max-w-4xl mx-auto">
      <li class="m-0 rounded-[var(--radius)] border border-border bg-bg-elevated/90 px-5 py-5 text-left">
        <p class="font-display font-semibold text-fg m-0">Simple result</p>
        <p class="text-sm text-muted m-0 mt-2 leading-relaxed">
          See Likely AI-generated, Likely real, or Unclear in a large, easy-to-read panel.
        </p>
      </li>
      <li class="m-0 rounded-[var(--radius)] border border-border bg-bg-elevated/90 px-5 py-5 text-left">
        <p class="font-display font-semibold text-fg m-0">Stays in your browser</p>
        <p class="text-sm text-muted m-0 mt-2 leading-relaxed">
          Your selected image is not uploaded to our servers for analysis. See
          <a href="/privacy/" class="text-accent">Privacy</a>.
        </p>
      </li>
      <li class="m-0 rounded-[var(--radius)] border border-border bg-bg-elevated/90 px-5 py-5 text-left">
        <p class="font-display font-semibold text-fg m-0">Honest limits</p>
        <p class="text-sm text-muted m-0 mt-2 leading-relaxed">
          Estimates can be wrong. Not for court, school discipline, or other high-stakes decisions.
          Read the <a href="/faq/" class="text-accent">FAQ</a>.
        </p>
      </li>
    </ul>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-12 sm:px-6" aria-labelledby="blog-heading">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between max-w-4xl mx-auto">
      <div>
        <h2 id="blog-heading" class="font-display text-2xl font-bold text-fg m-0">From the blog</h2>
        <p class="mt-2 text-muted m-0 text-pretty max-w-xl">
          Guides for people searching how to spot AI images — written for ranking and clarity.
        </p>
      </div>
      <a href="/blog/" class="text-sm font-semibold text-accent shrink-0">All posts →</a>
    </div>
    <ul class="mt-6 grid list-none p-0 gap-4 sm:grid-cols-3 max-w-4xl mx-auto">
      {
        featured.map((post) => (
          <li class="m-0 rounded-[var(--radius)] border border-border bg-bg-elevated/90 px-5 py-5">
            <a href={`/blog/${post.id}/`} class="no-underline block group">
              <p class="m-0 text-xs text-muted">{post.data.readMinutes} min read</p>
              <p class="font-display font-semibold text-fg m-0 mt-2 group-hover:text-accent text-balance">
                {post.data.title}
              </p>
              <p class="text-sm text-muted m-0 mt-2 leading-relaxed line-clamp-3">{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16 sm:px-6">
    <div
      class="max-w-4xl mx-auto rounded-[var(--radius)] border border-border bg-bg-elevated/70 px-5 py-5 sm:px-6 text-sm text-muted leading-relaxed"
    >
      <p class="m-0 font-semibold text-fg">Important</p>
      <p class="m-0 mt-2">
        Image Identifier provides free, informal estimates only. It is not legal proof, a
        certificate of authenticity, or professional advice. Learn more in
        <a href="/terms/" class="text-accent">Terms</a>,
        <a href="/faq/" class="text-accent">FAQ</a>, and
        <a href="/blog/why-ai-image-checkers-are-not-legal-proof/" class="text-accent"
          >why checkers are not legal proof</a
        >.
      </p>
    </div>
  </section>
</BaseLayout>
