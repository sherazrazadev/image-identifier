---
const nav = [
  { href: "/blog/", label: "Blog" },
  { href: "/faq/", label: "FAQ" },
  { href: "/privacy/", label: "Privacy" },
];
---

<header class="border-b border-border/80 bg-bg/70 backdrop-blur-md sticky top-0 z-20 no-print">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a
      href="/"
      class="font-display text-lg font-bold text-fg no-underline hover:text-accent sm:text-xl"
    >
      Image Identifier
    </a>
    <nav aria-label="Primary" class="flex flex-wrap items-center justify-end gap-x-4 gap-y-1 text-sm text-muted">
      {
        nav.map((item) => (
          <a href={item.href} class="text-muted no-underline hover:text-fg">
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
