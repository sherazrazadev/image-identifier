---
const links = [
  // { href: "/guides/", label: "Guides" },
  { href: "/privacy/", label: "Privacy" },
  { href: "/terms/", label: "Terms" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
---

<footer class="mt-auto border-t border-border/80 bg-bg-elevated/40 no-print">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p class="m-0">
      <span class="font-display font-semibold text-fg">Image Identifier</span>
      <span class="mx-2 text-border">·</span>
      Free AI vs real check
    </p>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-4 gap-y-2">
      {
        links.map((item) => (
          <a href={item.href} class="text-muted no-underline hover:text-fg">
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
